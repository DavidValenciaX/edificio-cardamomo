# Firebase Web App (cliente Vite)
# Copia estos valores desde Firebase Console > Project settings > Your apps > Web app.
# En local Vite los lee desde .env/.env.local. En GitHub Actions se inyectan al hacer el build.
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-firebase-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-web-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-firebase-measurement-id"
VITE_FIRESTORE_DATABASE_ID="your-firestore-database-id"
VITE_ADMIN_EMAIL="your-email@example.com"
VITE_PROJECT_PAUSED="false"
VITE_PROJECT_PAUSE_MESSAGE="Proyecto en pausa."
# En desarrollo local dejalo vacio para usar el mismo origen (http://localhost:3000).
# En GitHub Actions / produccion apunta a la URL publica de Cloud Run.
VITE_API_BASE_URL=""

# Firebase Admin SDK (servidor)
# Descarga el JSON desde Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Guarda el archivo como service-account.json en la raiz del proyecto solo para desarrollo local.
GOOGLE_APPLICATION_CREDENTIALS="your-service-account-json"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIRESTORE_DATABASE_ID="your-firestore-database-id"
ADMIN_EMAIL="your-email@example.com"
# En Cloud Run conviene dejarlo en false y usar Cloud Scheduler para /api/sync-ical.
ENABLE_ICAL_SYNC_TIMER="false"
# Para Cloud Scheduler con OIDC, usa la URL exacta del endpoint como audience.
CLOUD_SCHEDULER_OIDC_AUDIENCE=""
# Correo de la service account usada por Cloud Scheduler para firmar el token OIDC.
CLOUD_SCHEDULER_OIDC_EMAIL=""
# Si el frontend y backend corren en el mismo origen en local, dejalo vacio.
# Si separas origenes, agrega una lista separada por comas.
CORS_ALLOWED_ORIGINS=""

# Entorno: development | production
NODE_ENV=development

# Estas variables NO hacen falta en .env local porque solo se usan en GitHub Actions / despliegue:
# GCP_WORKLOAD_IDENTITY_PROVIDER
# GCP_SERVICE_ACCOUNT
# GCP_PROJECT_ID
# GCP_REGION
# CLOUD_RUN_SERVICE
# CLOUD_RUN_RUNTIME_SERVICE_ACCOUNT

# Firebase Web App (cliente Vite)
# Copia estos valores desde Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-firebase-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-web-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-firebase-measurement-id"
VITE_FIRESTORE_DATABASE_ID="(default)"
VITE_ADMIN_EMAIL="edificiocardamomo@gmail.com"
VITE_API_BASE_URL=""

# Firebase Admin SDK (servidor)
# Descarga el JSON desde Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Guarda el archivo como service-account.json en la raiz del proyecto solo para desarrollo local.
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIRESTORE_DATABASE_ID="(default)"
ADMIN_EMAIL="edificiocardamomo@gmail.com"
ENABLE_ICAL_SYNC_TIMER="false"
CORS_ALLOWED_ORIGINS=""

# Entorno: development | production
NODE_ENV=development

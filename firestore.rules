rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.email == 'edificiocardamomo@gmail.com'
      );
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'edificiocardamomo@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasOptionalString(data, key, maxSize) {
      return !data.keys().hasAny([key]) || (data[key] is string && data[key].size() <= maxSize);
    }

    function hasOptionalBool(data, key) {
      return !data.keys().hasAny([key]) || data[key] is bool;
    }

    function hasOptionalTimestamp(data, key) {
      return !data.keys().hasAny([key]) || data[key] is timestamp || data[key] == request.time;
    }

    function isValidGuestContact(contact) {
      return contact is map
        && contact.fullName is string && contact.fullName.size() >= 3 && contact.fullName.size() <= 150
        && contact.phone is string && contact.phone.size() >= 7 && contact.phone.size() <= 50
        && contact.identification is string && contact.identification.size() >= 3 && contact.identification.size() <= 80;
    }

    // Entity validation blueprints
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 200
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 150
        && (data.role == 'guest' || data.role == 'admin')
        && hasOptionalString(data, 'phone', 50)
        && hasOptionalString(data, 'identification', 80)
        && hasOptionalBool(data, 'isTemporary')
        && hasOptionalString(data, 'authProvider', 30)
        && hasOptionalTimestamp(data, 'createdAt')
        && hasOptionalTimestamp(data, 'updatedAt')
        && hasOptionalTimestamp(data, 'convertedAt');
    }

    function isValidRoom(data) {
      return data.name is string && data.name.size() <= 150
        && data.description is string && data.description.size() <= 3000
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 30
        && data.pricePerNight is number && data.pricePerNight > 0
        && (
          !data.keys().hasAny(['features']) ||
          (
            data.features is map
            && data.features.bedrooms is int && data.features.bedrooms >= 1 && data.features.bedrooms <= 20
            && data.features.beds is int && data.features.beds >= 1 && data.features.beds <= 30
            && data.features.hasSofaBed is bool
            && data.features.hasWifi is bool
            && data.features.hasTv is bool
            && data.features.hasFullKitchen is bool
            && data.features.hasFridge is bool
            && data.features.hasPrivateBathroom is bool
          )
        )
        && data.images is list && data.images.size() <= 10
        && data.blockedDates is list && data.blockedDates.size() <= 1000;
    }

    function isValidRoomIntegration(data, roomId) {
      return data.roomId == roomId
        && data.airbnbIcalUrl is string && data.airbnbIcalUrl.size() <= 1000
        && data.bookingIcalUrl is string && data.bookingIcalUrl.size() <= 1000;
    }

    function isValidBooking(data) {
      return data.roomId is string && data.roomId.size() <= 128
        && data.userId == request.auth.uid
        && isValidGuestContact(data.guestContact)
        && hasOptionalString(data, 'userEmail', 200)
        && hasOptionalString(data, 'userDisplayName', 150)
        && (!data.keys().hasAny(['userStatus']) || data.userStatus == 'temporary' || data.userStatus == 'registered')
        && data.checkIn is string && data.checkIn.size() == 10
        && data.checkOut is string && data.checkOut.size() == 10
        && (data.status == 'confirmed' || data.status == 'cancelled')
        && data.totalPrice is number && data.totalPrice > 0
        && data.createdAt == request.time;
    }

    function isValidSettings(data) {
      return data.hotelLogoUrl is string && data.hotelLogoUrl.size() <= 2048
        && data.heroBannerUrl is string && data.heroBannerUrl.size() <= 2048
        && data.notificationConfig is map
        && data.notificationConfig.emailEnabled is bool
        && data.notificationConfig.emailDestination is string && data.notificationConfig.emailDestination.size() <= 200
        && data.notificationConfig.whatsappEnabled is bool
        && data.notificationConfig.whatsappDestination is string && data.notificationConfig.whatsappDestination.size() <= 100
        && data.notificationConfig.smsEnabled is bool
        && data.notificationConfig.smsDestination is string && data.notificationConfig.smsDestination.size() <= 100;
    }

    function isValidPublicContent(data) {
      return data.intro is string && data.intro.size() <= 500
        && data.policies is map
        && data.policies.parking is string && data.policies.parking.size() <= 2000
        && data.policies.breakfast is string && data.policies.breakfast.size() <= 2000
        && data.policies.checkIn is string && data.policies.checkIn.size() <= 2000
        && data.policies.checkOut is string && data.policies.checkOut.size() <= 2000
        && data.policies.earlyArrival is string && data.policies.earlyArrival.size() <= 2000
        && data.policies.lateDeparture is string && data.policies.lateDeparture.size() <= 2000
        && data.policies.partialStayDiscount is string && data.policies.partialStayDiscount.size() <= 2000
        && data.policies.reception is string && data.policies.reception.size() <= 2000
        && data.policies.selfCheckIn is string && data.policies.selfCheckIn.size() <= 2000
        && data.policies.electronicInvoice is string && data.policies.electronicInvoice.size() <= 2000
        && data.faqItems is list && data.faqItems.size() <= 20
        && data.nearbyPlaces is list && data.nearbyPlaces.size() <= 30;
    }

    // MATCHES
    
    // USERS
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ADMINS EXPLICIT COLLECTION
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    // ROOMS
    match /rooms/{roomId} {
      allow get: if true; 
      allow list: if true; 
      allow create: if isAdmin() && isValidRoom(request.resource.data) && isValidId(roomId);
      allow update: if (isAdmin() && isValidRoom(request.resource.data)) || (
        // Guests/Systems can only update blockedDates when reserving
        isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedDates'])
        && request.resource.data.blockedDates is list
      );
      allow delete: if isAdmin();
    }

    // PRIVATE ROOM INTEGRATIONS
    match /roomIntegrations/{roomId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(roomId)
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && isValidRoomIntegration(request.resource.data, roomId);
      allow delete: if isAdmin();
    }

    // BOOKINGS
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() 
        && isValidBooking(request.resource.data) 
        && isValidId(bookingId)
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId));
      allow update: if isSignedIn() && (
        // Guests can cancel their own bookings
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'cancelled')
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // PUBLIC GUEST CONTENT
    match /publicContent/{docId} {
      allow get: if docId == 'global';
      allow list: if isAdmin();
      allow create, update: if docId == 'global' && isAdmin() && isValidPublicContent(request.resource.data);
      allow delete: if docId == 'global' && isAdmin();
    }

    // SETTINGS
    match /settings/{docId} {
      allow get: if true; 
      allow write: if isAdmin() && isValidSettings(request.resource.data);
    }
  }
}
